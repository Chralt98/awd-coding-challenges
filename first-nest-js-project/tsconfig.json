{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["node"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // enables the legacy decorator implementation, which is required by NestJS
    "experimentalDecorators": true,
    // tells the compiler to include type information in the compiled output. `NestJS` reads this metadata at runtime to figure out the type of each constructor parameter and which provider to inject.
    // Without `emitDecoratorMetadata`, `NestJS` cannot resolve constructor dependencies, and the `DI` system does not work.
    "emitDecoratorMetadata": true
  }
}
