{
  "name": "scoreboard-service",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc",
    "docker:build": "docker build -t scoreboard-service .",
    "docker:run": "docker run -d --name scoreboard-service --network arcade-net -p 3000:3000 scoreboard-service",
    "compose:up": "docker compose -f compose.yaml up -d",
    "compose:down": "docker compose -f compose.yaml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
