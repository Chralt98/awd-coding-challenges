{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(now | strftime(\"%Y-%m-%d %H:%M:%S\")): wrote \\(.tool_input.file_path)\"' >> \"${CLAUDE_PROJECT_DIR}/claude-edits.log\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command'); case \"$cmd\" in *git\\ commit*) npm --prefix \"${CLAUDE_PROJECT_DIR}\" run lint 1>&2 || exit 2 ;; esac"
          }
        ]
      }
    ]
  }
}
