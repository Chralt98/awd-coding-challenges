{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(now | strftime(\"%Y-%m-%d %H:%M:%S\")): wrote \\(.tool_input.file_path)\"' >> \"${CLAUDE_PROJECT_DIR}/claude-edits.log\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(.*git commit)",
        "hooks": [
          {
            "type": "command",
            "command": "npm --prefix \"${CLAUDE_PROJECT_DIR}\" run lint"
          }
        ]
      }
    ]
  }
}
